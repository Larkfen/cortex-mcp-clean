# ─────────────────────────────────────────────────────────────
# Cortex XDR MCP — configuración de ejemplo
# Copia este archivo a `.env` y rellena tus valores.
# NUNCA subas tu `.env` real a git ni lo compartas.
# ─────────────────────────────────────────────────────────────

# API REST de Cortex XDR (Advanced/Standard API key)
# La URL lleva el prefijo `api-` delante de tu FQDN de tenant.
CORTEX_MCP_PAPI_URL=https://api-<tu-tenant>.xdr.<region>.paloaltonetworks.com
CORTEX_MCP_PAPI_AUTH_ID=<tu_api_key_id>
CORTEX_MCP_PAPI_AUTH_HEADER=<tu_api_key>
# Tipo de key. RECOMENDADO por seguridad: "advanced" (firma cada request con
# nonce+timestamp+hash, la key no viaja en claro). Usa "standard" solo si no
# puedes usar una key Advanced.
CORTEX_MCP_AUTH_TYPE=advanced

# Transporte del MCP: stdio (por defecto) | http
MCP_TRANSPORT=stdio

# ── Opcionales ───────────────────────────────────────────────
# Host del webapp de Cortex (sin el prefijo `api-`), solo si usas
# las tools de webapp/prevention profiles:
# CORTEX_WEBAPP_HOST=https://<tu-tenant>.xdr.<region>.paloaltonetworks.com

# Habilitar tools de escritura (aislar endpoints, block list, etc.)
# MCP_WRITE_TOOLS_ENABLED=true
# MCP_ISOLATE_ENDPOINT_TOOL_ENABLED=true

# Nivel de log: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
